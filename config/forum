##
# HTTPS Servers
##

# Forum
server {
    listen          443 default_server ssl;
    server_name     huitcent.xyz;
    root            /srv/forum;

    add_header      Strict-Transport-Security "max-age=15768000; includeSubdomains; preload";

    rewrite         ^/robots.txt$ /static/robots.txt last;
    rewrite         ^/favicon.ico$ /static/favicon.ico last;

    location / {
        proxy_pass  http://unix:/var/run/forum/forum.sock;
        include     proxy_params;
    }

    location /static {
        try_files   $uri $uri/ /;
    }

    location /media {
        try_files   $uri $uri/ /;
    }
    ssl_certificate /etc/letsencrypt/live/huitcent.xyz-0001/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/huitcent.xyz-0001/privkey.pem; # managed by Certbot


}
